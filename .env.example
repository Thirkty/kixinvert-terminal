# ========================================================
# KixInvertAPP - Environment Variables Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ========================================================

# Database Connection (PostgreSQL with SSL recommended in production)
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/bvc_portfolio

# Host & Port Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# JWT Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change_this_to_a_secure_64_character_hex_key_for_production


# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookie Security (Set to True in HTTPS production environments)
SESSION_COOKIE_SECURE=False

# Telegram Bot Integration (@BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=KixInvert_bot

